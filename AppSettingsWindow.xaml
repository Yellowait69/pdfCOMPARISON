<Window x:Class="PDFComparison.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PDFComparison.Converters"
        Title="Paramètres — Rapports, Partage &amp; Boutons de Scan"
        Width="1240" Height="820"
        MinWidth="960" MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryBtn">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,16,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="9" Background="#DBEAFE" Margin="0,0,12,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Paramètres &amp; Boutons de Scan Automatique" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Personnalisez l'emplacement de vos rapports, le mail Partager et créez vos propres boutons de scan" FontSize="12.5" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Annuler" Click="BtnCancel_Click" Style="{StaticResource SecondaryBtn}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="Enregistrer &amp; Appliquer" Click="BtnSaveAndClose_Click" Style="{StaticResource PrimaryBtn}"/>
            </StackPanel>
        </DockPanel>

        <!-- ONGLETS ÉPURÉS -->
        <TabControl x:Name="MainTabs" Grid.Row="1" BorderThickness="0" Background="Transparent">

            <!-- ========================================================================= -->
            <!-- ONGLET 1 : DOSSIER DES RAPPORTS & MAIL PARTAGER                           -->
            <!-- ========================================================================= -->
            <TabItem Header="  1. Emplacement des Rapports &amp; Mail Partager  " FontSize="13.5" FontWeight="SemiBold">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="26,22" Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

                            <TextBlock Text="Emplacement par défaut des Rapports" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                            <TextBlock Text="Choisissez le dossier (local, OneDrive ou partage réseau) où la Synthèse et les vues Côte à Côte sont créées. Le bouton Partager pointe automatiquement vers ce dossier."
                                       FontSize="12.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtDefaultReportDir"
                                         Grid.Column="0"
                                         Text="{Binding Settings.DefaultReportOutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="ReportSettings_TextChanged"
                                         conv:FileDropBehavior.IsEnabled="True"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Parcourir..." Click="BtnBrowseDefaultReportDir_Click" Style="{StaticResource SecondaryBtn}"/>
                            </Grid>

                            <CheckBox IsChecked="{Binding Settings.CreateSubfolderPerRun}"
                                      Checked="ReportSettings_CheckChanged"
                                      Unchecked="ReportSettings_CheckChanged"
                                      Margin="0,2,0,22" VerticalContentAlignment="Center">
                                <TextBlock Text="Créer automatiquement un sous-dossier horodaté / par release à chaque lancement" FontSize="12.5" Foreground="#334155"/>
                            </CheckBox>

                            <Separator Background="#E2E8F0" Margin="0,0,0,20"/>

                            <TextBlock Text="Personnalisation du Mail « Partager »" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Destinataire(s) (optionnel) :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding Settings.ShareMailRecipients, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="ReportSettings_TextChanged"
                                         VerticalAlignment="Center"
                                         ToolTip="Ex: collegue@domaine.com; equipe@domaine.com"/>

                                <TextBlock Grid.Row="1" Text="Objet du mail :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding Settings.ShareMailSubject, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="ReportSettings_TextChanged"
                                         VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Text="Message d'introduction :" VerticalAlignment="Top" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Settings.ShareMailIntro, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="ReportSettings_TextChanged"
                                         AcceptsReturn="True" Height="76" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,6,0,0"/>
                            </Grid>

                            <Border Background="#F8FAFC" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="Aperçu automatique du mail généré par le bouton Partager :" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtMailPreview" FontSize="12" Foreground="#334155" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- ONGLET 2 : BOUTONS DE SCAN AUTOMATIQUE (STYLE ÉQUIPE TESTING)             -->
            <!-- ========================================================================= -->
            <TabItem Header="  2. Boutons de Scan Automatique (type Équipe Testing)  " FontSize="13.5" FontWeight="SemiBold">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLONNE GAUCHE : LISTE DES BOUTONS + IMPORT/EXPORT -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Vos boutons de scan" FontWeight="Bold" FontSize="14.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <Button Content="+ Nouveau" Click="BtnAddScanProfile_Click" Style="{StaticResource PrimaryBtn}" Padding="11,5" FontSize="12" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <ListBox x:Name="ListScanProfiles"
                                     Grid.Row="1"
                                     ItemsSource="{Binding Settings.ScanProfiles}"
                                     SelectionChanged="ListScanProfiles_SelectionChanged"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Margin" Value="0,3"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ButtonColorHex}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ButtonName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding RootPath}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button Content="Dupliquer" Click="BtnDuplicateScanProfile_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnDeleteProfile" Content="Supprimer" Click="BtnDeleteScanProfile_Click" Style="{StaticResource DangerBtn}" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Button Content="Importer (.json)" Click="BtnImportScanProfile_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0" ToolTip="Importer un bouton configuré partagé par un collègue"/>
                                    <Button Content="Partager (.json)" Click="BtnExportScanProfile_Click" Style="{StaticResource SecondaryBtn}" Margin="4,0,0,0" ToolTip="Exporter ce bouton avec ses dossiers et ses règles dédiées"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- COLONNE DROITE : ÉDITION DU BOUTON SÉLECTIONNÉ -->
                    <Border x:Name="PanelSelectedProfile" Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="24,18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- 1. IDENTITÉ & COULEUR & DOSSIER RAPPORT OPTIONNEL -->
                                <TextBlock Text="1. Nom du bouton &amp; Dossier de rapport" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="40"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Nom affiché sur le bouton :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ButtonName, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>

                                    <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Couleur :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                                        <Button Width="22" Height="22" Margin="0,0,5,0" Cursor="Hand" Tag="#059669" Click="BtnPickColor_Click" Background="#059669" BorderThickness="0"/>
                                        <Button Width="22" Height="22" Margin="0,0,5,0" Cursor="Hand" Tag="#0284C7" Click="BtnPickColor_Click" Background="#0284C7" BorderThickness="0"/>
                                        <Button Width="22" Height="22" Margin="0,0,5,0" Cursor="Hand" Tag="#7C3AED" Click="BtnPickColor_Click" Background="#7C3AED" BorderThickness="0"/>
                                        <Button Width="22" Height="22" Margin="0,0,5,0" Cursor="Hand" Tag="#D97706" Click="BtnPickColor_Click" Background="#D97706" BorderThickness="0"/>
                                        <Button Width="22" Height="22" Margin="0,0,14,0" Cursor="Hand" Tag="#0F766E" Click="BtnPickColor_Click" Background="#0F766E" BorderThickness="0"/>

                                        <CheckBox IsChecked="{Binding ShowInMainToolbar}" Content="Afficher en haut de l'écran principal" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="Dossier rapport spécifique :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding CustomReportOutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                 conv:FileDropBehavior.IsEnabled="True"
                                                 Margin="0,0,8,0"
                                                 ToolTip="Laissez vide pour utiliser le dossier de rapports par défaut (Onglet 1), ou choisissez un dossier dédié à ce bouton"/>
                                        <Button Grid.Column="1" Content="Parcourir..." Click="BtnBrowseCustomReportDir_Click" Style="{StaticResource SecondaryBtn}"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Text="Astuce : laissez « Dossier rapport spécifique » vide pour utiliser votre emplacement par défaut (Onglet 1), ou renseignez un dossier dédié pour ce bouton (le mail Partager s'ajustera automatiquement)."
                                           FontSize="11.5" Foreground="#64748B" Margin="0,0,0,14"/>

                                <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

                                <!-- 2. LOGIQUE DES DOSSIERS SOURCE & CIBLE -->
                                <TextBlock Text="2. Logique automatique des dossiers Source &amp; Cible" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Organisation des dossiers :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                    <ComboBox x:Name="CmbTopologyMode" Grid.Column="1"
                                              SelectionChanged="CmbTopologyMode_SelectionChanged"
                                              Padding="9,6" FontSize="12.5" FontWeight="SemiBold">
                                        <ComboBoxItem Tag="ProductSubfolders" Content="Par sous-dossier Produit (ex: Racine \ [Canal] \ Produit \ Source vs Target)"/>
                                        <ComboBoxItem Tag="MirrorTrees" Content="Deux dossiers séparés en miroir (Dossier Source global vs Dossier Cible global)"/>
                                        <ComboBoxItem Tag="AutoDiscoverPairs" Content="Détection automatique dans un dossier (trouve tous les sous-dossiers Source / Cible)"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Champs communs Racine (ou Racine Source en mode Miroir) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dossier Racine (ou Source) :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox Grid.Column="1" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" conv:FileDropBehavior.IsEnabled="True" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Parcourir..." Click="BtnBrowseProfileRoot_Click" Style="{StaticResource SecondaryBtn}"/>
                                </Grid>

                                <!-- Mode MIROIR : Dossier Cible global -->
                                <Grid Visibility="{Binding IsMirrorTreesMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dossier Cible global :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox Grid.Column="1" Text="{Binding SecondaryTargetRootPath, UpdateSourceTrigger=PropertyChanged}" conv:FileDropBehavior.IsEnabled="True" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Parcourir..." Click="BtnBrowseSecondaryTarget_Click" Style="{StaticResource SecondaryBtn}"/>
                                </Grid>

                                <!-- Mode PAR SOUS-DOSSIER PRODUIT -->
                                <StackPanel Visibility="{Binding IsProductSubfoldersMode, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Sous-dossiers Canaux :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBox Grid.Column="1" Text="{Binding ChannelsCsv, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex: Bank, Broker — ou laissez vide si les produits sont directement sous la Racine"/>
                                        <TextBlock Grid.Column="2" Text="(Optionnel — ex. Bank, Broker. Vide = produits directs)" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>

                                    <CheckBox IsChecked="{Binding UseReleaseFolder}"
                                              Content="Utiliser un sous-dossier de Release / Version (ex: 2026_R11, v2, Sprint_4...)"
                                              FontWeight="SemiBold" Foreground="#334155" Margin="210,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Chemin Source du produit :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBox Grid.Column="1" Text="{Binding SourceSubfolderTemplate, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Column="3" Text="Chemin Cible du produit :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="4" Text="{Binding TargetSubfolderTemplate, UpdateSourceTrigger=PropertyChanged}" ToolTip="Utilisez {Release}\Target si vous avez coché Release, sinon Target ou Obtenu"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Mode DÉTECTION AUTOMATIQUE -->
                                <StackPanel Visibility="{Binding IsAutoDiscoverMode, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Noms reconnus Source :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AutoSourceFolderNamesCsv, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Text="Noms reconnus Cible :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AutoTargetFolderNamesCsv, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Bandeau d'aperçu de la logique Source -> Cible -->
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="7" Padding="11,7" Margin="0,4,0,14">
                                    <TextBlock Text="{Binding LiveTopologyPreview}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                </Border>

                                <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

                                <!-- 3. APPAIRAGE DES NOMS DE PDF -->
                                <TextBlock Text="3. Appairage des fichiers PDF (si les noms diffèrent)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Méthode d'appairage :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                    <ComboBox x:Name="CmbPairingStrategy" Grid.Column="1"
                                              SelectionChanged="CmbPairingStrategy_SelectionChanged"
                                              Padding="9,6" FontSize="12.5" FontWeight="SemiBold">
                                        <ComboBoxItem Tag="SmartAuto" Content="Automatique intelligent — Nom, Code commun ou Contenu PDF (gère des noms totalement différents)"/>
                                        <ComboBoxItem Tag="FolderOrder" Content="Par ordre dans le dossier (1er PDF Source avec 1er PDF Cible, 2e avec 2e...)"/>
                                        <ComboBoxItem Tag="CustomRegexOnly" Content="Par clé / Regex personnalisée extraite du nom de fichier"/>
                                        <ComboBoxItem Tag="ExactOrStemOnly" Content="Nom de fichier identique ou sans date (isole strictement les PDF manquants)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Visibility="{Binding IsCustomRegexStrategy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Regex d'identifiant commun :" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox Grid.Column="1" Text="{Binding CustomFileMatchingRegex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                                </Grid>

                                <Separator Background="#E2E8F0" Margin="0,8,0,14"/>

                                <!-- 4. RÈGLES & EXCLUSIONS DU BOUTON -->
                                <TextBlock Text="4. Règles &amp; Exclusions appliquées par ce bouton" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <CheckBox IsChecked="{Binding DefaultIgnoreDates}" Content="Pré-cocher « Ignorer les dates »" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,22,4"/>
                                    <CheckBox IsChecked="{Binding DefaultIgnoreHeaderFooter}" Content="Pré-cocher « Exclure en-tête &amp; pied de page »" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,22,4"/>
                                    <CheckBox IsChecked="{Binding DefaultWriteProductOutputs}" Content="Pré-cocher « Copier dans Output produit »" Foreground="#334155" Margin="0,0,0,4"/>
                                </WrapPanel>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkUseDedicatedRules"
                                                  IsChecked="{Binding UseDedicatedRules}"
                                                  Content="Utiliser un jeu de Règles &amp; Zones d'Exclusion dédié uniquement à ce bouton (indépendant des règles générales)"
                                                  FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                                        <StackPanel Orientation="Horizontal" Visibility="{Binding UseDedicatedRules, Converter={StaticResource BoolToVis}}">
                                            <Button Content="Configurer les zones &amp; règles Regex de ce bouton..."
                                                    Click="BtnEditDedicatedRules_Click"
                                                    Style="{StaticResource PrimaryBtn}" Padding="14,6" Margin="0,0,8,0"/>
                                            <Button Content="Copier depuis les règles générales"
                                                    Click="BtnCopyFromGeneralRules_Click"
                                                    Style="{StaticResource SecondaryBtn}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
