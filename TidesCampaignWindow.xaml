<Window x:Class="PDFComparison.Views.TidesCampaignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Équipe Testing"
        Width="1180" Height="780"
        MinWidth="920" MinHeight="560"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryBtn">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. BARRE SUPÉRIEURE COMPACTE ADAPTATIVE (TITRE + DOSSIER(S) + RELEASE OPTIONNELLE + CONFIGURER) -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Titre & badges -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtWindowTitle" Text="Équipe Testing" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                <Border x:Name="BdReleaseBadge" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtReleaseBadge" Text="Release : 2026_R11" FontWeight="SemiBold" FontSize="11.5" Foreground="#1D4ED8"/>
                </Border>
                <Border x:Name="BdRulesBadge" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Règles dédiées" FontWeight="SemiBold" FontSize="11" Foreground="#047857"/>
                </Border>
            </StackPanel>

            <!-- Zone centrale des chemins (Racine ou Source + Cible) -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="ColSecondaryTarget" Width="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LblRootPath" Grid.Column="0" Text="Racine :" FontWeight="SemiBold" FontSize="12.5" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>

                <TextBox x:Name="TxtRootPath" Grid.Column="1"
                         Text="\\sppdfc01\TIDES\Life"
                         Padding="9,5" FontSize="12.5" Foreground="#0F172A" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="2" Content="Parcourir" Click="BtnBrowseRoot_Click" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"/>

                <!-- Affiché uniquement en mode Deux Dossiers Séparés (MirrorTrees) -->
                <Grid x:Name="PnlSecondaryTarget" Grid.Column="3" Margin="14,0,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Cible :" FontWeight="SemiBold" FontSize="12.5" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSecondaryTargetPath" Grid.Column="1"
                             Padding="9,5" FontSize="12.5" Foreground="#0F172A" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Parcourir" Click="BtnBrowseSecondaryTarget_Click" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"/>
                </Grid>

                <!-- Affiché uniquement quand le dossier Release est utilisé -->
                <StackPanel x:Name="PnlReleaseSelector" Grid.Column="4" Orientation="Horizontal" Margin="14,0,0,0">
                    <TextBlock Text="Release :" FontWeight="SemiBold" FontSize="12.5" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbReleaseFolder"
                              Width="145"
                              IsEditable="True"
                              FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"
                              VerticalContentAlignment="Center" Padding="7,4"
                              SelectionChanged="CmbReleaseFolder_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <!-- Boutons Scanner & Configurer -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Content="Scanner" Style="{StaticResource PrimaryBtn}"/>
                <Button x:Name="BtnConfigureScan" Click="BtnConfigureScan_Click" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"
                        ToolTip="Modifier la logique des dossiers, l'appairage PDF ou les règles de ce bouton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#475569" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Configurer" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. OPTIONS PRÉ-COCHÉES & FILTRES SUR UN BANDEAU LÉGER -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <!-- Ligne d'options pré-cochées -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkIgnoreDates" IsChecked="True" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,22,0" VerticalContentAlignment="Center">
                        <TextBlock Text="Ignorer les dates" FontSize="12.5"/>
                    </CheckBox>

                    <CheckBox x:Name="ChkIgnoreHeaderFooter" IsChecked="True" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,22,0" VerticalContentAlignment="Center">
                        <TextBlock Text="Exclure en-tête &amp; pied de page" FontSize="12.5"/>
                    </CheckBox>

                    <CheckBox x:Name="ChkWriteProductOutputs" IsChecked="True" Foreground="#334155" VerticalContentAlignment="Center">
                        <TextBlock x:Name="TxtWriteProductOutputs" Text="Copier dans &lt;Produit&gt;\Output" FontSize="12.5"/>
                    </CheckBox>
                </WrapPanel>

                <!-- Ligne sélection rapide + canal dynamique + statut -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Cocher prêts" Click="BtnCheckReady_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,5,0"/>
                        <Button Content="Tout cocher" Click="BtnCheckAll_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,5,0"/>
                        <Button Content="Tout décocher" Click="BtnUncheckAll_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,0"/>
                    </StackPanel>

                    <StackPanel x:Name="PanelChannelFilters" Grid.Column="1" Orientation="Horizontal"/>

                    <TextBlock x:Name="TxtDiscoveryStatus" Grid.Column="2"
                               Text="Recherche des dossiers..."
                               FontSize="12" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. TABLEAU DES PRODUITS / DOSSIERS ÉPURÉ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2">
            <DataGrid x:Name="GridProducts"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      RowHeight="38">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Sélection" Width="82">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Click="ProductCheckBox_Click"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Canal / Groupe" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="ChannelBadge" Background="#F1F5F9" CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock x:Name="ChannelTxt" Text="{Binding Channel}" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Channel}" Value="Bank">
                                        <Setter TargetName="ChannelBadge" Property="Background" Value="#DBEAFE"/>
                                        <Setter TargetName="ChannelTxt" Property="Foreground" Value="#1D4ED8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Channel}" Value="Broker">
                                        <Setter TargetName="ChannelBadge" Property="Background" Value="#EDE9FE"/>
                                        <Setter TargetName="ChannelTxt" Property="Foreground" Value="#6D28D9"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Produit / Dossier" Binding="{Binding ProductName}" Width="210" FontWeight="Bold" Foreground="#0F172A" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="Statut" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBd" Background="#D1FAE5" CornerRadius="9" Padding="10,2" HorizontalAlignment="Left"
                                        ToolTip="{Binding AvailableReleasesCsv}">
                                    <TextBlock x:Name="StatusTxt" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11.5" Foreground="#059669"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsReady}" Value="False">
                                        <Setter TargetName="StatusBd" Property="Background" Value="#FEF3C7"/>
                                        <Setter TargetName="StatusTxt" Property="Foreground" Value="#B45309"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PDF Source" Binding="{Binding SourcePdfCount}" Width="105" FontWeight="SemiBold" Foreground="#334155" IsReadOnly="True"/>

                    <DataGridTextColumn Header="PDF Cible" Binding="{Binding TargetPdfCount}" Width="105" FontWeight="SemiBold" Foreground="#2563EB" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="Dossier" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Ouvrir" Click="BtnOpenProductFolder_Click" Tag="{Binding}" Style="{StaticResource SecondaryBtn}" Padding="8,3" FontSize="11.5"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. BARRE INFÉRIEURE SIMPLE -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtSelectionSummary" Text="0 dossier coché" FontWeight="SemiBold" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Annuler" Click="BtnCancel_Click" Style="{StaticResource SecondaryBtn}" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="BtnStartCampaign" Click="BtnStartCampaign_Click" Style="{StaticResource PrimaryBtn}" Background="#059669" Padding="18,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtBtnStart" Text="Lancer la comparaison" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
