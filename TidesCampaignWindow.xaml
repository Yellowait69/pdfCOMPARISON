<Window x:Class="PDFComparison.Views.TidesCampaignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campagne Rapide Testing — TIDES Life (Bank &amp; Broker)"
        Width="1180" Height="780"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryBtn">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. EN-TÊTE -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="11" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,14,0">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Campagne Rapide Équipe Testing — TIDES Life" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <Border Background="#DBEAFE" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="1. Bank ➔ 2. Broker" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Détection automatique des produits dans \\sppdfc01\TIDES\Life • Appairage Source vs Année_Rmois\Target • Comparaison du texte visible à l'œil nu"
                               FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                <TextBlock x:Name="TxtReleaseBadge" Text="Release active : 2026_R11" FontWeight="Bold" FontSize="13" Foreground="#1D4ED8"/>
            </Border>
        </Grid>

        <!-- 2. CONFIGURATION DU PARTAGE RÉSEAU & DE LA RELEASE DU MOIS -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Racine TIDES Life :" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox x:Name="TxtRootPath" Grid.Column="1"
                             Text="\\sppdfc01\TIDES\Life"
                             Padding="10,7" FontSize="13" Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2" Content="Parcourir..." Click="BtnBrowseRoot_Click" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#059669" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Dossier Cible (Mois) :" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ComboBox x:Name="CmbReleaseFolder" Grid.Column="5"
                              IsEditable="True"
                              FontSize="13" FontWeight="Bold" Foreground="#0F172A"
                              VerticalContentAlignment="Center" Padding="8,5"
                              SelectionChanged="CmbReleaseFolder_SelectionChanged"
                              ToolTip="Nom du dossier de release mensuel (par défaut Année_Rmois actuel, ex: 2026_R11 en novembre)"/>

                    <Button x:Name="BtnRefresh" Grid.Column="6" Click="BtnRefresh_Click" Style="{StaticResource PrimaryBtn}" Padding="14,7" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Scanner Bank &amp; Broker" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Options de comparaison rapide "Texte à l'œil nu" -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkVisibleTextOnly" IsChecked="True" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,22,0" VerticalContentAlignment="Center"
                                  ToolTip="Compare l'intégralité du texte visible à l'œil nu sur toute la page en ignorant uniquement le texte blanc sur blanc invisible, les ancres #...# et les filigranes SPECIMEN.">
                            <TextBlock Text="👁️ Comparer tout le texte visible à l'œil nu (zéro masquage de texte visible)" FontSize="12.5"/>
                        </CheckBox>

                        <CheckBox x:Name="ChkIgnoreDates" IsChecked="False" Foreground="#334155" Margin="0,0,22,0" VerticalContentAlignment="Center"
                                  ToolTip="Cochez si vous souhaitez ignorer les dates d'impression / du jour qui changent entre Source et Target.">
                            <TextBlock Text="Ignorer les dates répétées (JJ/MM/AAAA)" FontSize="12.5"/>
                        </CheckBox>

                        <CheckBox x:Name="ChkIgnoreHeaderFooter" IsChecked="False" Foreground="#334155" Margin="0,0,22,0" VerticalContentAlignment="Center"
                                  ToolTip="Cochez pour exclure l'en-tête (130pt) et le pied de page (40pt). Laissez décoché pour vérifier aussi le texte de l'en-tête.">
                            <TextBlock Text="Exclure En-tête (130pt) &amp; Pied de page" FontSize="12.5"/>
                        </CheckBox>

                        <CheckBox x:Name="ChkWriteProductOutputs" IsChecked="True" FontWeight="SemiBold" Foreground="#059669" VerticalContentAlignment="Center"
                                  ToolTip="Enregistre aussi automatiquement les PDF annotés et un Summary_PDFComparatorPro.csv dans le sous-dossier Output de chaque produit (ex: ...\SP.DH\2026_R11\Output).">
                            <TextBlock Text="📂 Écrire aussi les rapports dans &lt;Produit&gt;\&lt;Release&gt;\Output" FontSize="12.5"/>
                        </CheckBox>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. BARRE D'ÉTAT DU SCAN -->
        <Border Grid.Row="2" x:Name="BannerStatus" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDiscoveryStatus" Text="Recherche des produits dans Bank et Broker..." FontWeight="Medium" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtSelectionSummary" Grid.Column="1" Text="0 produit coché" FontWeight="Bold" FontSize="12.5" Foreground="#1D4ED8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 4. BARRE DE SÉLECTION RAPIDE (COCHER / DÉCOCHER / FILTRER BANK & BROKER) -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="☑️ Cocher Prêts" Click="BtnCheckReady_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"
                        ToolTip="Cocher uniquement les produits ayant un dossier Source et le dossier Release du mois avec des PDF"/>
                <Button Content="☑️ Tout cocher" Click="BtnCheckAll_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                <Button Content="☐ Tout décocher" Click="BtnUncheckAll_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                <Button Content="🏦 Cocher Bank uniquement" Click="BtnCheckBankOnly_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Foreground="#1D4ED8"/>
                <Button Content="🤝 Cocher Broker uniquement" Click="BtnCheckBrokerOnly_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,0" Foreground="#6D28D9"/>
            </StackPanel>

            <!-- Filtre d'affichage Canal -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Button x:Name="BtnFilterAll" Content="Tous" Click="BtnFilterChannel_Click" Tag="ALL" Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0"/>
                <Button x:Name="BtnFilterBank" Content="Bank" Click="BtnFilterChannel_Click" Tag="Bank" Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0"/>
                <Button x:Name="BtnFilterBroker" Content="Broker" Click="BtnFilterChannel_Click" Tag="Broker" Style="{StaticResource SecondaryBtn}"/>
            </StackPanel>

            <!-- Recherche de produit -->
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtFilterProduct" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0,6" FontSize="12.5"
                             TextChanged="TxtFilterProduct_TextChanged"
                             ToolTip="Filtrer par nom de produit (ex: SP.DH, SP.SFP...)"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. TABLEAU DES PRODUITS BANK & BROKER AVEC CASES À COCHER -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="6">
            <DataGrid x:Name="GridProducts"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      RowHeight="42">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Case à cocher -->
                    <DataGridTemplateColumn Header="Comparer" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Click="ProductCheckBox_Click"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Canal (1. Bank / 2. Broker) -->
                    <DataGridTemplateColumn Header="Canal (Ordre)" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="ChannelBadge" Background="#DBEAFE" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock x:Name="ChannelTxt" Text="{Binding Channel}" FontWeight="Bold" FontSize="11.5" Foreground="#1D4ED8"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Channel}" Value="Broker">
                                        <Setter TargetName="ChannelBadge" Property="Background" Value="#EDE9FE"/>
                                        <Setter TargetName="ChannelTxt" Property="Foreground" Value="#6D28D9"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Nom du Produit -->
                    <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="145" FontWeight="Bold" Foreground="#0F172A" IsReadOnly="True"/>

                    <!-- Statut -->
                    <DataGridTemplateColumn Header="Statut Release &amp; Source" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBd" Background="#D1FAE5" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                    <TextBlock x:Name="StatusTxt" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11.5" Foreground="#059669"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsReady}" Value="False">
                                        <Setter TargetName="StatusBd" Property="Background" Value="#FEF3C7"/>
                                        <Setter TargetName="StatusTxt" Property="Foreground" Value="#B45309"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Dossier Source -->
                    <DataGridTextColumn Header="PDF Source" Binding="{Binding SourcePdfCount}" Width="95" FontWeight="SemiBold" Foreground="#334155" IsReadOnly="True"/>

                    <!-- Dossier Target -->
                    <DataGridTextColumn Header="PDF Target" Binding="{Binding TargetPdfCount}" Width="95" FontWeight="SemiBold" Foreground="#2563EB" IsReadOnly="True"/>

                    <!-- Releases disponibles dans le produit -->
                    <DataGridTextColumn Header="Releases 20XX_R* détectées" Binding="{Binding AvailableReleasesCsv}" Width="*" Foreground="#64748B" IsReadOnly="True"/>

                    <!-- Ouvrir le dossier dans l'explorateur -->
                    <DataGridTemplateColumn Header="Dossier" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="📂 Ouvrir" Click="BtnOpenProductFolder_Click" Tag="{Binding}" Style="{StaticResource SecondaryBtn}" Padding="8,4" FontSize="11.5"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 6. BARRE D'ACTION INFÉRIEURE -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Ordre d'exécution automatique : " Foreground="#64748B" FontSize="12.5" VerticalAlignment="Center"/>
                <TextBlock Text="1. Tous les produits Bank cochés ➔ 2. Tous les produits Broker cochés" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12.5" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Annuler" Click="BtnCancel_Click" Style="{StaticResource SecondaryBtn}" Padding="16,9" Margin="0,0,10,0"/>
                <Button x:Name="BtnStartCampaign" Click="BtnStartCampaign_Click" Style="{StaticResource PrimaryBtn}" Background="#059669" Padding="22,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtBtnStart" Text="Lancer la Comparaison des Produits Cochés" FontSize="13.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
