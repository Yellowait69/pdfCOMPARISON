<Window x:Class="PDFComparison.Views.VisualDiffViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspecteur Visuel Interactif A/B, Calque &amp; Heatmap SSIM"
        Height="860" Width="1340"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRE D'OUTILS SUPÉRIEURE -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <!-- Titre & Navigation Pages -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DocTitleText" Text="Document" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Button Content="◄ Préc." Click="OnPrevPageClick" Padding="10,5" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                    <Border Background="#0F172A" CornerRadius="6" Padding="12,5" Margin="0,0,6,0">
                        <TextBlock x:Name="PageIndicatorText" Text="Page 1 / 1" Foreground="#E2E8F0" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="Suiv. ►" Click="OnNextPageClick" Padding="10,5" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,14,0"/>

                    <Border Background="#1E3A8A" CornerRadius="6" Padding="10,5">
                        <TextBlock x:Name="SsimScoreBadge" Text="SSIM : 100.0%" Foreground="#93C5FD" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Modes d'affichage & Zoom -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnSideBySide" Content="1. Côte à Côte (A | B)" Click="OnModeSideBySideClick" Padding="12,6" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button x:Name="BtnOverlay" Content="2. Superposition Calque" Click="OnModeOverlayClick" Padding="12,6" Background="#334155" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button x:Name="BtnBlink" Content="3. Mode Blink A/B" Click="OnModeBlinkClick" Padding="12,6" Background="#334155" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button x:Name="BtnHeatmap" Content="4. Heatmap SSIM" Click="OnModeHeatmapClick" Padding="12,6" Background="#334155" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,16,0"/>

                    <!-- Contrôle d'opacité pour le mode Superposition -->
                    <StackPanel x:Name="OverlayControlsPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Opacité Cible :" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="OverlayOpacitySlider" Minimum="0" Maximum="1" Value="0.5" Width="100" VerticalAlignment="Center" ValueChanged="OnOverlayOpacityChanged"/>
                    </StackPanel>

                    <!-- Contrôle Zoom -->
                    <TextBlock Text="Zoom :" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="ZoomSlider" Minimum="0.5" Maximum="2.5" Value="1.0" Width="100" VerticalAlignment="Center" ValueChanged="OnZoomChanged"/>
                    <TextBlock x:Name="ZoomPercentText" Text="100%" Foreground="White" FontWeight="Bold" FontSize="12" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ZONE DE VISUALISATION -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="MainScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                </Grid.LayoutTransform>

                <!-- MODE 1 : CÔTE À CÔTE -->
                <Grid x:Name="SideBySideView" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ATTENDU (SOURCE)" Foreground="#F87171" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                        <Border Background="White" BorderBrush="#475569" BorderThickness="1" CornerRadius="4">
                            <Image x:Name="ImgSideSource" Stretch="None"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="OBTENU (CIBLE)" Foreground="#34D399" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                        <Border Background="White" BorderBrush="#475569" BorderThickness="1" CornerRadius="4">
                            <Image x:Name="ImgSideTarget" Stretch="None"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- MODE 2 & 3 : SUPERPOSITION CALQUE / BLINK A-B -->
                <StackPanel x:Name="OverlayBlinkView" Visibility="Collapsed" HorizontalAlignment="Center">
                    <TextBlock x:Name="OverlayModeLabel" Text="MODE SUPERPOSITION / BLINK" Foreground="#60A5FA" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <Border Background="White" BorderBrush="#475569" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Image x:Name="ImgOverlaySource" Stretch="None"/>
                            <Image x:Name="ImgOverlayTarget" Stretch="None" Opacity="0.5"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- MODE 4 : CARTE THERMIQUE (HEATMAP SSIM) -->
                <StackPanel x:Name="HeatmapView" Visibility="Collapsed" HorizontalAlignment="Center">
                    <TextBlock Text="CARTE THERMIQUE DES DIFFÉRENCES (ROUGE/MAGENTA = ÉCART RÉEL)" Foreground="#F43F5E" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <Border Background="White" BorderBrush="#475569" BorderThickness="1" CornerRadius="4">
                        <Image x:Name="ImgHeatmap" Stretch="None"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
