<Window x:Class="PDFComparison.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PDFComparison.ViewModels"
        Title="Automated PDF Comparator - Pro Version" Height="700" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="Button" x:Key="ModernPrimaryButton">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ModernSecondaryButton" BasedOn="{StaticResource ModernPrimaryButton}">
            <Setter Property="Background" Value="#6B7280"/>
            <Setter Property="Padding" Value="15,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4B5563"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#F9FAFB" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="PDF Comparator Pro" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="Automated comparison and visual diff report generation" FontSize="14" Foreground="#6B7280" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="15" ShadowDepth="3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Source Directory:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151"/>
                <TextBox Grid.Column="1" Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseSourceCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="10,0,0,0"/>

                <TextBlock Grid.Row="2" Text="Target Directory:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Command="{Binding BrowseTargetCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="10,0,0,0"/>

                <TextBlock Grid.Row="4" Text="Reports Directory:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />

                <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="Open" Command="{Binding OpenOutputDirectoryCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,8,0" Padding="15,6"/>
                    <Button Content="Share" Command="{Binding ShareViaOutlookCommand}" Style="{StaticResource ModernPrimaryButton}" Background="#10B981" Padding="15,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <Button Content="Start Comparison" Command="{Binding StartComparisonCommand}"
                    Style="{StaticResource ModernPrimaryButton}"
                    HorizontalAlignment="Left" MinWidth="220" FontSize="15"
                    IsEnabled="{Binding IsNotProcessing}"/>

            <Grid Margin="0,20,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="Medium" Foreground="#4B5563" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} / {1}">
                            <Binding Path="ProgressValue" />
                            <Binding Path="ProgressMax" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>

            <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" Height="8" Foreground="#10B981" Background="#E5E7EB" BorderThickness="0">
                <ProgressBar.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </ProgressBar.Resources>
            </ProgressBar>
        </StackPanel>

        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="5">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="15" ShadowDepth="3"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Pairs}" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column"
                      AlternatingRowBackground="#F9FAFB" RowBackground="White"
                      GridLinesVisibility="None" BorderThickness="0" RowHeight="40">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#6B7280"/>
                        <Setter Property="Padding" Value="15,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/> <Setter Property="Foreground" Value="#111827"/> </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#374151"/> <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ref No" Binding="{Binding MatchKey}" Width="80" FontWeight="Bold"/>

                    <DataGridTextColumn Header="Source File" Binding="{Binding SourcePath}" Width="220">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding SourcePath}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Completed Time" Binding="{Binding CompletedTime, StringFormat=\{0:HH:mm:ss\}}" Width="105" Foreground="#6B7280"/>

                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Details (Diff)" Binding="{Binding ErrorMessage}" Width="180"/>

                    <DataGridTextColumn Header="Report Path" Binding="{Binding ReportPath}" Width="180" Foreground="#6B7280">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding ReportPath}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Action" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Open Report"
                                        Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Hidden}"
                                        IsEnabled="{Binding HasReport}"
                                        Padding="10,4"
                                        Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.3"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>