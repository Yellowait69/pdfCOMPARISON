<Window x:Class="PDFComparison.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PDFComparison.ViewModels"
        xmlns:conv="clr-namespace:PDFComparison.Converters"
        Title="PDF Comparator" Height="860" Width="1360"
        MinWidth="960" MinHeight="560"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="Button" x:Key="ModernPrimaryButton">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ModernSecondaryButton">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="FilterPillButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="PillBd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="ModernInputTextBox">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           Margin="10,0,8,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. BARRE SUPÉRIEURE ÉPURÉE -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="7" Background="#DBEAFE" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PDF Comparator" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Profil :" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding AvailablePresets}"
                                  SelectedItem="{Binding SelectedPreset}"
                                  IsEnabled="{Binding IsNotProcessing}"
                                  Width="180" FontSize="12" FontWeight="Medium" Foreground="#0F172A"
                                  BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Command="{Binding OpenProfileSettingsCommand}"
                        Style="{StaticResource ModernSecondaryButton}"
                        Margin="0,0,6,0"
                        IsEnabled="{Binding IsNotProcessing}"
                        ToolTip="Zones d'exclusion et règles Regex">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Règles &amp; Exclusions" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenDocumentationCommand}"
                        Style="{StaticResource ModernSecondaryButton}"
                        Padding="8,5"
                        Margin="0,0,6,0"
                        ToolTip="Documentation">
                    <TextBlock Text="?" FontWeight="Bold" Foreground="#64748B"/>
                </Button>

                <Button Command="{Binding OpenTidesCampaignCommand}"
                        Style="{StaticResource ModernPrimaryButton}"
                        Background="#059669"
                        Margin="0,0,6,0"
                        IsEnabled="{Binding IsNotProcessing}"
                        ToolTip="Campagne Testing TIDES Life (Bank &amp; Broker)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Campagne Testing" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding CancelComparisonCommand}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource ModernPrimaryButton}"
                        Background="#DC2626"
                        Margin="0,0,6,0">
                    <TextBlock Text="Stop"/>
                </Button>

                <Button Command="{Binding StartComparisonCommand}"
                        Style="{StaticResource ModernPrimaryButton}"
                        IsEnabled="{Binding IsNotProcessing}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Comparer" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. CHEMINS COMPACTS (SOURCE & CIBLE SUR UNE SEULE LIGNE + RAPPORTS) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <Grid Height="29">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Source -->
                    <TextBlock Grid.Column="0" Text="Source :" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource ModernInputTextBox}"
                             Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Dossier ou PDF attendu..."
                             conv:FileDropBehavior.IsEnabled="True"
                             Margin="0,0,6,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding BrowseSourceCommand}" Content="Dossier" Style="{StaticResource ModernSecondaryButton}" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Command="{Binding BrowseSourceFileCommand}" Content="PDF" Style="{StaticResource ModernSecondaryButton}" Padding="8,4"/>
                    </StackPanel>

                    <!-- Cible -->
                    <TextBlock Grid.Column="4" Text="Cible :" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="5"
                             Style="{StaticResource ModernInputTextBox}"
                             Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Dossier ou PDF obtenu..."
                             conv:FileDropBehavior.IsEnabled="True"
                             Margin="0,0,6,0"/>
                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <Button Command="{Binding BrowseTargetCommand}" Content="Dossier" Style="{StaticResource ModernSecondaryButton}" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Command="{Binding BrowseTargetFileCommand}" Content="PDF" Style="{StaticResource ModernSecondaryButton}" Padding="8,4"/>
                    </StackPanel>
                </Grid>

                <Grid Height="29" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Rapports :" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource ModernInputTextBox}"
                             Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Dossier des rapports..."
                             conv:FileDropBehavior.IsEnabled="True"
                             Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding OpenHtmlReportCommand}" Content="Synthèse Web" Style="{StaticResource ModernPrimaryButton}" Padding="10,4" Margin="0,0,5,0"/>
                        <Button Command="{Binding OpenOutputDirectoryCommand}" Content="Synthèse PDF" Style="{StaticResource ModernSecondaryButton}" Padding="10,4" Margin="0,0,5,0"/>
                        <Button Command="{Binding OpenCsvReportCommand}" Content="Excel" Style="{StaticResource ModernSecondaryButton}" Padding="10,4" Margin="0,0,5,0"/>
                        <Button Command="{Binding ShareViaOutlookCommand}" Content="Partager" Style="{StaticResource ModernSecondaryButton}" Padding="10,4"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. BARRE DE FILTRES SYNTHÉTIQUES + RECHERCHE + STATUT -->
        <StackPanel Grid.Row="2" Margin="0,0,0,6">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <!-- Filtres rapides sans Alertes Critiques -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="ALL" Style="{StaticResource FilterPillButton}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tous" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalPairsCount}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="IDENTICAL" Style="{StaticResource FilterPillButton}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Conformes" FontSize="12" FontWeight="SemiBold" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IdenticalPairsCount}" FontSize="13" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="DIFFERENT" Style="{StaticResource FilterPillButton}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Différences" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DifferentPairsCount}" FontSize="13" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                            <Border Background="#DBEAFE" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasUniqueDiffsBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding UniqueDiffsBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="ISSUES" Style="{StaticResource FilterPillButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Manquants / Erreurs" FontSize="12" FontWeight="SemiBold" Foreground="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IssuesPairsCount}" FontSize="13" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Message d'état centré/discret -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0" ClipToBounds="True">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#475569" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Option regroupement produit + compteur progression -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <CheckBox IsChecked="{Binding IsGroupedByProductDiff}"
                              Content="Regrouper par produit"
                              FontWeight="SemiBold" FontSize="11.5" Foreground="#334155"
                              VerticalContentAlignment="Center" Margin="0,0,10,0" Cursor="Hand"
                              ToolTip="Regroupe en une seule ligne les mêmes différences trouvées sur plusieurs PDF d'un même code produit"/>
                    <TextBlock FontWeight="SemiBold" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1}">
                                <Binding Path="ProgressValue"/>
                                <Binding Path="ProgressMax"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- Recherche -->
                <TextBox Grid.Column="3"
                         Style="{StaticResource ModernInputTextBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Filtrer produit, fichier, texte..."/>
            </Grid>

            <ProgressBar Minimum="0" Maximum="{Binding ProgressBarMax}" Value="{Binding ProgressValue}" Height="3" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0"/>
        </StackPanel>

        <!-- 4. GRAND TABLEAU SYNTHÉTIQUE (AVEC DÉFILEMENT HORIZONTAL & VERTICAL AUTO) -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2">
            <Grid>
                <DataGrid ItemsSource="{Binding FilteredPairsView}"
                          SelectedItem="{Binding SelectedPair}"
                          AutoGenerateColumns="False"
                          CanUserResizeColumns="True"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          RowHeight="38">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- 1. Canal / Produit -->
                        <DataGridTemplateColumn Header="Canal • Produit" Width="135" MinWidth="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="ProdBadge" Padding="7,2" CornerRadius="5" HorizontalAlignment="Left" Background="#F1F5F9">
                                        <TextBlock x:Name="ProdText" Text="{Binding DisplayProductBadge}" FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Channel}" Value="Bank">
                                            <Setter TargetName="ProdBadge" Property="Background" Value="#DBEAFE"/>
                                            <Setter TargetName="ProdText" Property="Foreground" Value="#1D4ED8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Channel}" Value="Broker">
                                            <Setter TargetName="ProdBadge" Property="Background" Value="#EDE9FE"/>
                                            <Setter TargetName="ProdText" Property="Foreground" Value="#6D28D9"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. Document / Regroupement -->
                        <DataGridTemplateColumn Header="Document" Width="270" MinWidth="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MatchKey}"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ErrorMessage}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Résumé synthétique -->
                        <DataGridTemplateColumn Header="Résumé" Width="*" MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="NoteTxt"
                                               Text="{Binding DisplayDocumentNote}"
                                               Foreground="#334155"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ErrorMessage}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Identical">
                                            <Setter TargetName="NoteTxt" Property="Foreground" Value="#94A3B8"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. Statut -->
                        <DataGridTemplateColumn Header="Statut" Width="140" MinWidth="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="BadgeBorder" Padding="9,3" CornerRadius="10" HorizontalAlignment="Left" Background="#F1F5F9">
                                        <TextBlock x:Name="BadgeText" Text="{Binding DisplayStatusBadge}" FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Different">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#FEE2E2"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Identical">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#D1FAE5"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#059669"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="MissingInTarget">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#FEF3C7"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#FECACA"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 5. Nombre de différences -->
                        <DataGridTemplateColumn Header="Diffs" Width="68" MinWidth="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="DiffNum"
                                               Text="{Binding DisplayDiffCountBadge}"
                                               FontWeight="Bold"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Center"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Different">
                                            <Setter TargetName="DiffNum" Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 6. Actions épurées (Sans Vue A|B) -->
                        <DataGridTemplateColumn Header="Actions" Width="195" MinWidth="185">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Content="Côte à Côte"
                                                Style="{StaticResource ModernPrimaryButton}"
                                                Padding="10,3" FontSize="11.5" Margin="0,0,5,0"
                                                ToolTip="Ouvrir les 2 PDF fusionnés côte à côte"/>

                                        <Button x:Name="BtnApproveRow"
                                                Command="{Binding DataContext.ApproveSelectedPairCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="✓"
                                                Visibility="Collapsed"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                Foreground="#059669" FontWeight="Bold"
                                                Padding="7,3" FontSize="11.5" Margin="0,0,5,0"
                                                ToolTip="Valider comme conforme"/>

                                        <Button Command="{Binding DataContext.RetestPairCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="↻"
                                                FontWeight="Bold" FontSize="12" Padding="7,3"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                ToolTip="Re-tester avec les règles actuelles"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Different">
                                            <Setter TargetName="BtnApproveRow" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- État vide sobre -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Aucun document comparé" FontSize="15" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Sélectionnez Source et Cible ci-dessus ou lancez une Campagne Testing." FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. PANNEAU DE DÉTAIL SIMPLIFIÉ EN BAS (UNIQUEMENT AU CLIC SUR UNE LIGNE EN ÉCART) -->
        <Border Grid.Row="4" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,6,0,0"
                MaxHeight="152"
                Visibility="{Binding HasSelectedPairWithDiffs, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,5" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Visibility="{Binding SelectedPair.IsGroupedRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="PDF :" FontWeight="SemiBold" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding SelectedPair.GroupedSourcePairs}"
                                      SelectedItem="{Binding SelectedPair.SelectedGroupedMember}"
                                      DisplayMemberPath="FileNameOnly"
                                      Width="180" FontSize="11.5" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Button Content="✓ Valider"
                                Command="{Binding ApproveSelectedPairCommand}"
                                Style="{StaticResource ModernPrimaryButton}"
                                Background="#059669" Padding="9,3" FontSize="11.5" Margin="0,0,5,0"/>
                        <Button Content="↻ Re-tester"
                                Command="{Binding RetestPairCommand}"
                                Style="{StaticResource ModernSecondaryButton}"
                                Padding="8,3" FontSize="11.5" Margin="0,0,5,0"/>
                        <Button Content="Côte à Côte"
                                Command="{Binding OpenReportCommand}"
                                Style="{StaticResource ModernPrimaryButton}"
                                Padding="10,3" FontSize="11.5" Margin="0,0,5,0"/>
                        <Button Content="✕"
                                Command="{Binding CloseQuickInspectorCommand}"
                                Style="{StaticResource ModernSecondaryButton}"
                                Padding="7,3" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedPair.MatchKey}"
                               FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedPair.DiffBlocks}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding DisplayPageLabel}" FontWeight="SemiBold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>

                                    <Border Grid.Column="1" Background="#DBEAFE" CornerRadius="4" Padding="5,1" Margin="0,0,8,0"
                                            Visibility="{Binding IsMultiPdfGrouped, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="{Binding ImpactedDocumentsTooltip}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OccurrenceBadgeText}" Foreground="#1E40AF" FontWeight="Bold" FontSize="10.5"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding OldText}" Foreground="#991B1B" FontWeight="Medium" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding OldText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="➔" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding NewText}" Foreground="#065F46" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding NewText}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <Button Grid.Column="5"
                                            Content="Ignorer (Règle)"
                                            Command="{Binding DataContext.IgnoreDiffBlockTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            Padding="8,2" FontSize="11"
                                            ToolTip="Enregistrer de façon permanente une règle Regex pour toujours ignorer cet écart"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
