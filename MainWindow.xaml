<Window x:Class="PdfComparer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfComparer.ViewModels"
        Title="Comparateur PDF Automatisé - Version Pro" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Configuration des dossiers" Grid.Row="0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" Margin="0,10,0,0"/>
                    <RowDefinition Height="Auto" Margin="0,10,0,0"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Dossier Source :" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="5" IsReadOnly="True"/>
                <Button Grid.Column="2" Content="Parcourir..." Command="{Binding BrowseSourceCommand}" Margin="10,0,0,0" Padding="5"/>

                <TextBlock Grid.Row="1" Text="Dossier Target :" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="5" IsReadOnly="True"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Parcourir..." Command="{Binding BrowseTargetCommand}" Margin="10,0,0,0" Padding="5"/>

                <TextBlock Grid.Row="2" Text="Dossier Rapports :" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="5" IsReadOnly="True"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Parcourir..." Command="{Binding BrowseOutputCommand}" Margin="10,0,0,0" Padding="5"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Margin="0,15,0,15">
            <Button Content="Lancer la Comparaison" Command="{Binding StartComparisonCommand}"
                    Padding="10" FontWeight="Bold" Background="#0078D7" Foreground="White" FontSize="14"
                    IsEnabled="{Binding IsNotProcessing}"/>

            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Margin="0,15,0,5" Foreground="#333"/>
            <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" Height="20"/>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Pairs}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" AlternatingRowBackground="#F9F9F9"
                  GridLinesVisibility="Horizontal" BorderBrush="#DDD">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Clé Document" Binding="{Binding MatchKey}" Width="100"/>
                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="130" FontWeight="Bold"/>
                <DataGridTextColumn Header="Fichier Source" Binding="{Binding SourcePath}" Width="300"/>
                <DataGridTextColumn Header="Détails / Erreurs" Binding="{Binding ErrorMessage}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>