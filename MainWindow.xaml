<Window x:Class="PDFComparison.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PDFComparison.ViewModels"
        xmlns:conv="clr-namespace:PDFComparison.Converters"
        Title="Automated PDF Comparator - Pro Version" Height="890" Width="1360"
        MinWidth="1000" MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="Button" x:Key="ModernPrimaryButton">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="0.5" CenterY="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ModernSecondaryButton" BasedOn="{StaticResource ModernPrimaryButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="KpiFilterCardButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="ModernInputTextBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#94A3B8"
                                           FontSize="12.5"
                                           Margin="14,0,10,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,12,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. BARRE SUPÉRIEURE (GRID SANS CHEVAUCHEMENT) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Titre & Sous-titre à gauche -->
            <Grid Grid.Column="0" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#DBEAFE" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PDF Comparator Pro" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="10,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Zéro Faux-Positif • Regroupé par Produit" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Comparaison stricte du texte visible uniquement, vue Côte à Côte au même niveau &amp; synthèse décisionnelle"
                               FontSize="12" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Contrôles & Bouton Lancer à droite -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Sélecteur de Profil Métier encapsulé proprement -->
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Profil :" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12.5"/>
                        <ComboBox ItemsSource="{Binding AvailablePresets}"
                                  SelectedItem="{Binding SelectedPreset}"
                                  IsEnabled="{Binding IsNotProcessing}"
                                  Width="195" FontSize="12.5" FontWeight="Medium" Foreground="#0F172A"
                                  BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                  ToolTip="Changer instantanément de profil métier (Factures, Audit Financier Strict, Juridique/CGV, ou Visuel Strict)"/>
                    </StackPanel>
                </Border>

                <Button Command="{Binding OpenProfileSettingsCommand}" Style="{StaticResource ModernSecondaryButton}" ToolTip="Configurer les zones d'exclusion (X/Y), les règles Regex et le moteur visuel SSIM" Margin="0,0,8,0" IsEnabled="{Binding IsNotProcessing}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Exclusions &amp; Règles" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenDocumentationCommand}" Style="{StaticResource ModernSecondaryButton}" ToolTip="Lire la documentation interne de l'architecture" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Doc" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Bouton Campagne Rapide Équipe Testing TIDES (\\sppdfc01\TIDES\Life) -->
                <Button Command="{Binding OpenTidesCampaignCommand}"
                        Style="{StaticResource ModernPrimaryButton}"
                        Background="#059669"
                        Padding="13,8"
                        Margin="0,0,8,0"
                        IsEnabled="{Binding IsNotProcessing}"
                        ToolTip="Ouvrir la Campagne Rapide Testing TIDES Life (\\sppdfc01\TIDES\Life : Bank puis Broker, Source vs 2026_Rmois)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Campagne Testing TIDES" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Bouton Annuler (visible pendant le traitement) -->
                <Button Command="{Binding CancelComparisonCommand}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource ModernPrimaryButton}" Background="#DC2626" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Stop" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Bouton Lancer Comparaison -->
                <Button Command="{Binding StartComparisonCommand}" Style="{StaticResource ModernPrimaryButton}" Padding="16,9" IsEnabled="{Binding IsNotProcessing}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lancer Comparaison" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. CARTE DE SÉLECTION DES DOSSIERS / FICHIERS & RAPPORTS (ALIGNEMENT PLEINE LARGEUR) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="14" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <!-- Lignes Source et Cible alignées proprement sur toute la largeur -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <!-- Source (Attendu) -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6" Background="#EFF6FF" Margin="0,0,8,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Source (Attendu)" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource ModernInputTextBox}"
                             Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Glissez-déposez le dossier ou fichier PDF Attendu (Source) ici, ou cliquez à droite..."
                             conv:FileDropBehavior.IsEnabled="True"
                             Margin="8,0,10,0"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding BrowseSourceCommand}" Style="{StaticResource ModernSecondaryButton}" MinWidth="98" Padding="11,6" Margin="0,0,6,0" ToolTip="Sélectionner un dossier complet de PDF">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dossier..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding BrowseSourceFileCommand}" Style="{StaticResource ModernSecondaryButton}" MinWidth="112" Padding="11,6" ToolTip="Sélectionner un fichier PDF unique (Comparaison directe 1-vs-1)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Fichier PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Cible (Obtenu) -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6" Background="#ECFDF5" Margin="0,0,8,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Cible (Obtenu)" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Style="{StaticResource ModernInputTextBox}"
                             Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Glissez-déposez le dossier ou fichier PDF Obtenu (Cible) ici, ou cliquez à droite..."
                             conv:FileDropBehavior.IsEnabled="True"
                             Margin="8,0,10,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding BrowseTargetCommand}" Style="{StaticResource ModernSecondaryButton}" MinWidth="98" Padding="11,6" Margin="0,0,6,0" ToolTip="Sélectionner un dossier complet de PDF">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dossier..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding BrowseTargetFileCommand}" Style="{StaticResource ModernSecondaryButton}" MinWidth="112" Padding="11,6" ToolTip="Sélectionner un fichier PDF unique (Comparaison directe 1-vs-1)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Fichier PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Separator Background="#F1F5F9" Margin="0,9,0,9"/>

                <!-- Ligne Dossier Rapports & Actions d'Export dans sa propre grille -->
                <Grid Height="35">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6" Background="#FFFBEB" Margin="0,0,8,0">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Dossier Rapports" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource ModernInputTextBox}"
                             Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Dossier de génération des rapports PDF, HTML et Excel..."
                             conv:FileDropBehavior.IsEnabled="True"
                             Margin="8,0,10,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding OpenHtmlReportCommand}" Style="{StaticResource ModernPrimaryButton}" Padding="13,7" Margin="0,0,6,0" ToolTip="Ouvrir le rapport de synthèse Web interactif (.HTML)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Synthèse Web" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenOutputDirectoryCommand}" Style="{StaticResource ModernSecondaryButton}" Padding="13,7" Margin="0,0,6,0" ToolTip="Ouvrir le rapport PDF global de synthèse">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Synthèse PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenCsvReportCommand}" Style="{StaticResource ModernSecondaryButton}" Padding="13,7" Margin="0,0,6,0" ToolTip="Ouvrir l'export d'audit dans Microsoft Excel (.CSV)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export Excel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShareViaOutlookCommand}" Style="{StaticResource ModernPrimaryButton}" Background="#059669" Padding="13,7" ToolTip="Partager les résultats par e-mail">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Partager" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. BARRE D'ÉTAT & PROGRESSION (0% VIDE AU REPOS AU LIEU DE 100% BLEU) -->
        <StackPanel Grid.Row="2" Margin="2,0,2,8">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="Medium" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,0"
                            ToolTip="Regroupe en une seule ligne les différences identiques présentes dans plusieurs PDF d'un même code produit">
                        <CheckBox IsChecked="{Binding IsGroupedByProductDiff}"
                                  Content="Regrouper mêmes diffs par Produit"
                                  FontWeight="SemiBold" FontSize="11.5" Foreground="#1E40AF"
                                  VerticalContentAlignment="Center" Cursor="Hand"/>
                    </Border>
                    <Border Background="#EFF6FF" CornerRadius="6" Padding="10,2">
                        <TextBlock FontWeight="Bold" FontSize="12" Foreground="#1D4ED8" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1} documents">
                                    <Binding Path="ProgressValue" />
                                    <Binding Path="ProgressMax" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>

            <ProgressBar Minimum="0" Maximum="{Binding ProgressBarMax}" Value="{Binding ProgressValue}" Height="5" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0">
                <ProgressBar.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </ProgressBar.Resources>
            </ProgressBar>
        </StackPanel>

        <!-- 4. CARTES KPI CLIQUABLES AVEC BARRE D'ACCENTUATION + CHAMP DE RECHERCHE AVEC ICÔNE -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- Carte 1 : Tous -->
            <Button Grid.Column="0" Command="{Binding SetStatusFilterCommand}" CommandParameter="ALL" Style="{StaticResource KpiFilterCardButton}" Padding="12,8" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#475569" CornerRadius="2" Margin="0,2,0,2"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="TOUS LES FICHIERS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalPairsCount}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Carte 2 : Conformes -->
            <Button Grid.Column="1" Command="{Binding SetStatusFilterCommand}" CommandParameter="IDENTICAL" Style="{StaticResource KpiFilterCardButton}" Padding="12,8" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#10B981" CornerRadius="2" Margin="0,2,0,2"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="CONFORMES (100%)" FontSize="10.5" FontWeight="Bold" Foreground="#059669"/>
                        <TextBlock Text="{Binding IdenticalPairsCount}" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Carte 3 : Avec Différences -->
            <Button Grid.Column="2" Command="{Binding SetStatusFilterCommand}" CommandParameter="DIFFERENT" Style="{StaticResource KpiFilterCardButton}" Padding="12,8" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#2563EB" CornerRadius="2" Margin="0,2,0,2"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="AVEC DIFFÉRENCES" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                            <TextBlock Text="{Binding DifferentPairsCount}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                            <Border Background="#DBEAFE" CornerRadius="5" Padding="6,1" Margin="8,2,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasUniqueDiffsBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding UniqueDiffsBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Carte 4 : Alertes Critiques -->
            <Button Grid.Column="3" Command="{Binding SetStatusFilterCommand}" CommandParameter="CRITICAL" Style="{StaticResource KpiFilterCardButton}" Padding="12,8" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#EF4444" CornerRadius="2" Margin="0,2,0,2"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="ALERTES CRITIQUES" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Text="{Binding CriticalPairsCount}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Carte 5 : Manquants / Erreurs -->
            <Button Grid.Column="4" Command="{Binding SetStatusFilterCommand}" CommandParameter="ISSUES" Style="{StaticResource KpiFilterCardButton}" Padding="12,8" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F59E0B" CornerRadius="2" Margin="0,2,0,2"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="MANQUANTS / ERREURS" FontSize="10.5" FontWeight="Bold" Foreground="#D97706"/>
                        <TextBlock Text="{Binding IssuesPairsCount}" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Barre de Recherche avec Icône Loupe & Placeholder -->
            <Border Grid.Column="5" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="12,0">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1">
                        <TextBlock Text="Filtrer par ID, fichier, montant..."
                                   Foreground="#94A3B8" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" Padding="0,6" FontSize="13" Foreground="#0F172A"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. TABLEAU PRINCIPAL DES DOCUMENTS (FOND BLANC PUR + EMPTY STATE ÉLÉGANT) -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="6">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="14" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <DataGrid ItemsSource="{Binding FilteredPairsView}"
                          SelectedItem="{Binding SelectedPair}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          Background="White"
                          RowBackground="White" AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="None" BorderThickness="0" RowHeight="42">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="14,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Canal / Produit" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="ProdBadge" Padding="8,3" CornerRadius="6" HorizontalAlignment="Left" Background="#F1F5F9">
                                        <TextBlock x:Name="ProdText" Text="{Binding DisplayProductBadge}" FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Channel}" Value="Bank">
                                            <Setter TargetName="ProdBadge" Property="Background" Value="#DBEAFE"/>
                                            <Setter TargetName="ProdText" Property="Foreground" Value="#1D4ED8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Channel}" Value="Broker">
                                            <Setter TargetName="ProdBadge" Property="Background" Value="#EDE9FE"/>
                                            <Setter TargetName="ProdText" Property="Foreground" Value="#6D28D9"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Document / Regroupement" Binding="{Binding MatchKey}" Width="235" FontWeight="Bold"/>

                        <DataGridTemplateColumn Header="Aperçu Différence / Fichiers" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayDocumentNote}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Statut" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="BadgeBorder" Padding="10,4" CornerRadius="12" HorizontalAlignment="Left" Background="#F1F5F9">
                                        <TextBlock x:Name="BadgeText" Text="{Binding DisplayStatusBadge}" FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Different">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#FEE2E2"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Identical">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#D1FAE5"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#059669"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="MissingInTarget">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#FEF3C7"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                            <Setter TargetName="BadgeBorder" Property="Background" Value="#FECACA"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Texte %" Binding="{Binding SsimScore, StringFormat=\{0:F1\}%}" Width="80" FontWeight="SemiBold" Foreground="#2563EB"/>

                        <DataGridTextColumn Header="Diffs Uniques" Binding="{Binding DiffCount}" Width="98" FontWeight="Bold" Foreground="#0F172A"/>

                        <DataGridTextColumn Header="Critiques" Binding="{Binding CriticalCount}" Width="82" FontWeight="Bold" Foreground="#DC2626"/>

                        <DataGridTemplateColumn Header="Ajouts" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding InsertionsCount}" Foreground="#059669" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Suppr." Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeletionsCount}" Foreground="#DC2626" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Heure" Binding="{Binding CompletedTime, StringFormat=\{0:HH:mm\}}" Width="70" Foreground="#94A3B8"/>

                        <DataGridTemplateColumn Header="Actions" Width="225">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.RetestPairCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="↻" FontWeight="Bold" FontSize="12" Padding="8,4" Margin="0,0,5,0"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                ToolTip="Re-tester ce document ou groupe de PDF"/>

                                        <Button Command="{Binding DataContext.OpenVisualInspectorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="📖 Vue A|B" FontSize="11.5" Padding="8,4" Margin="0,0,5,0"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                ToolTip="Voir Source et Target côte à côte au même niveau dans l'application"/>

                                        <Button Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Padding="10,4" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Ouvrir les 2 PDF annotés (Source et Target) côte à côte au même niveau">
                                             <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="11.5"/>
                                                <TextBlock Text="Côte à Côte" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#1D4ED8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ÉTAT VIDE (EMPTY STATE) QUAND AUCUN DOCUMENT N'EST CHARGÉ -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="60" Height="60" CornerRadius="30" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Aucun document comparé pour le moment" FontSize="16" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Glissez-déposez deux dossiers/fichiers PDF ci-dessus, ou cliquez sur « Campagne Testing TIDES » pour automatiser Bank &amp; Broker."
                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 6. INSPECTEUR RAPIDE DES DIFFÉRENCES (COMPACT, MASQUÉ PAR DÉFAUT, FERMABLE EN 1 CLIC) -->
        <Border Grid.Row="5" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,8,0,0"
                MaxHeight="148"
                Visibility="{Binding HasSelectedPairWithDiffs, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Visibility="{Binding SelectedPair.IsGroupedRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="PDF :" FontWeight="SemiBold" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding SelectedPair.GroupedSourcePairs}"
                                      SelectedItem="{Binding SelectedPair.SelectedGroupedMember}"
                                      DisplayMemberPath="FileNameOnly"
                                      Width="185" FontSize="11.5" VerticalContentAlignment="Center"
                                      ToolTip="Choisir lequel des PDF regroupés ouvrir en Côte à Côte"/>
                        </StackPanel>

                        <Button Content="↻ Re-tester"
                                Command="{Binding RetestPairCommand}"
                                Style="{StaticResource ModernSecondaryButton}"
                                Padding="9,3" FontSize="11.5" Margin="0,0,5,0"
                                ToolTip="Relancer immédiatement la comparaison avec les règles actuelles"/>
                        <Button Content="📖 Vue A|B"
                                Command="{Binding OpenVisualInspectorCommand}"
                                Style="{StaticResource ModernPrimaryButton}"
                                Background="#7C3AED" Padding="10,3" FontSize="11.5" Margin="0,0,5,0"
                                ToolTip="Ouvrir la vue Côte à Côte au même niveau dans l'application"/>
                        <Button Content="✓ Approuver Conforme"
                                Command="{Binding ApproveSelectedPairCommand}"
                                Style="{StaticResource ModernPrimaryButton}"
                                Background="#059669" Padding="10,3" FontSize="11.5" Margin="0,0,5,0"
                                ToolTip="Valider manuellement ce document ou groupe comme Conforme"/>
                        <Button Content="Source" Command="{Binding OpenSourcePdfCommand}" Style="{StaticResource ModernSecondaryButton}" Padding="8,3" FontSize="11.5" Margin="0,0,4,0"/>
                        <Button Content="Cible" Command="{Binding OpenTargetPdfCommand}" Style="{StaticResource ModernSecondaryButton}" Padding="8,3" FontSize="11.5" Margin="0,0,5,0"/>
                        <Button Content="🌐 Côte à Côte" Command="{Binding OpenReportCommand}" Style="{StaticResource ModernPrimaryButton}" Padding="10,3" FontSize="11.5" Margin="0,0,6,0"
                                ToolTip="Ouvrir les 2 vrais PDF annotés côte à côte au même niveau dans le navigateur"/>
                        <Button Content="✕"
                                Command="{Binding CloseQuickInspectorCommand}"
                                Style="{StaticResource ModernSecondaryButton}"
                                Padding="8,3" FontSize="11.5" FontWeight="Bold"
                                ToolTip="Réduire / Fermer ce panneau de synthèse rapide"/>
                    </StackPanel>

                    <Grid VerticalAlignment="Center" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Synthèse : " FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding SelectedPair.MatchKey}" FontWeight="Bold" FontSize="13" Foreground="#2563EB"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPair.ErrorMessage}" VerticalAlignment="Center"/>
                    </Grid>
                </DockPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedPair.DiffBlocks}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="9,4" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding DisplayPageLabel}" FontWeight="Bold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>

                                    <Border Grid.Column="1" Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                            Visibility="{Binding IsMultiPdfGrouped, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="{Binding ImpactedDocumentsTooltip}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OccurrenceBadgeText}" Foreground="#1E40AF" FontWeight="Bold" FontSize="10.5"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding Category}" FontWeight="SemiBold" FontSize="12" Foreground="#6D28D9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SeverityLabel}" FontWeight="Bold" FontSize="11.5" Foreground="#DC2626" VerticalAlignment="Center"/>

                                    <Border Grid.Column="4" Background="#FEF3C7" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                            Visibility="{Binding HasFinancialDelta, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FinancialDelta}" Foreground="#B45309" FontWeight="Bold" FontSize="11"/>
                                    </Border>

                                    <TextBlock Grid.Column="5" Text="{Binding OldText}" Foreground="#991B1B" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding OldText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="➔" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="{Binding NewText}" Foreground="#065F46" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding NewText}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <Button Grid.Column="8"
                                            Content="Ignorer (Créer Règle)"
                                            Command="{Binding DataContext.IgnoreDiffBlockTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ModernSecondaryButton}"
                                            Padding="8,2" FontSize="11"
                                            ToolTip="Créer automatiquement une règle Regex dans le profil actif pour ignorer ce texte sur tous les PDF"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
